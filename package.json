{
  "name": "antd-platform",
  "version": "0.2.6",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "patch-package": "^8.0.1",
    "pg": "^8.22.0"
  },
  "lint-staged": {
    "apps/backend/drizzle/*.sql": [
      "node scripts/validate-migrations.mjs"
    ],
    "apps/backend/src/database/schema.ts": [
      "node scripts/validate-drizzle-snapshot.mjs"
    ]
  }
}
