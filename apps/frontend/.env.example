# Frontend Environment Variables
#
# Copy this file to .env (committed defaults) or .env.local (local overrides, gitignored).

# ─── API routing ─────────────────────────────────────────────────────────────
# Keep EMPTY in local dev and production so all API calls go through the
# Next.js same-origin proxy (/api/v1/* → BACKEND_INTERNAL_URL).
# Setting this to a direct backend URL (e.g. http://localhost:4000) splits
# the refresh_token cookie across origins and breaks silent token refresh.
NEXT_PUBLIC_API_URL=

# ─── Backend proxy target (server-only, NOT public) ──────────────────────────
# The URL the Next.js rewrite proxy forwards /api/v1/* requests to.
# In local dev this defaults to http://localhost:4000 (see next.config.ts).
# In production set this to your backend host, e.g. https://api.coneeko.com
BACKEND_INTERNAL_URL=http://localhost:4000
