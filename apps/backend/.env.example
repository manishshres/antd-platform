# Server Settings
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public origin this API is reachable at. Used to prefill the POS connection QR
# code and to build the Uber OAuth redirect URI, so it must be an origin that
# outside callers (Uber, Telnyx, tablets) can actually resolve.
#
# Two valid shapes:
#   - Split hosts: the API has its own domain, e.g. https://api.your-domain.com
#   - Single host: only the frontend is exposed and Next rewrites /api/* to this
#     backend (see apps/frontend/next.config.ts). Then set this to the SAME
#     value as FRONTEND_URL. This is what a single ngrok tunnel needs — pointing
#     providers at a second tunnel on the same domain load-balances requests
#     between the two apps and half of them 404.
#
# Leave empty in local dev unless testing provider callbacks.
PUBLIC_API_URL=

# Docker deployment (used by docker-compose.yml, not the app itself)
# DOCKER_REGISTRY=docker.io/yourdockerhubuser
# BACKEND_VERSION=0.2.0
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=generate-a-long-random-password
# POSTGRES_DB=antd_db

# Database Settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/antd_db
# TLS to Postgres is inferred from the URL (?sslmode=require => on). Self-hosted
# dockerized Postgres has no TLS — leave the URL plain. Managed Postgres
# (Neon/RDS): append ?sslmode=require. DATABASE_SSL=true/false force-overrides.
# DATABASE_SSL=false

# JWT Configuration
JWT_SECRET=some-long-random-string-for-jwt-signing
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=another-long-random-string-for-refresh-token-signing
JWT_REFRESH_EXPIRATION=604800

# Telnyx Credentials
TELNYX_API_KEY=KEY0123456789_PLACEHOLDER
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_MASTER_AGENT_ID=assistant-placeholder
TELNYX_CONNECTION_ID=connection-placeholder
TELNYX_PUBLIC_KEY=telnyx-ed25519-public-key-base64-placeholder
TELNYX_STORAGE_BUCKET=restaurant-menu
TELNYX_STORAGE_REGION=us-east-1

# Stripe Settings
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# MQTT Broker Settings
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=test
MQTT_PASSWORD=test

# Redis Cache & Queues Settings
REDIS_URL=redis://localhost:6379

# Company / API root (GET /) — shown to anyone who opens the API host in a browser.
COMPANY_NAME=Coneeko
COMPANY_WEBSITE=https://coneeko.com
CONTACT_EMAIL=hello@coneeko.com
SUPPORT_EMAIL=support@coneeko.com

# Throttler Settings
# Master switch for all API rate limiting. Currently disabled while the Voice AI
# flow is being built out; set to true to re-enable every limit below.
THROTTLE_ENABLED=false
THROTTLE_ERROR_MESSAGE=ThrottlerException: Too Many Requests
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=5
THROTTLE_ACCOUNT_TTL=60000
THROTTLE_ACCOUNT_LIMIT=3

# Account Lockout Settings
ACCOUNT_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MS=900000

# Sentry Settings
SENTRY_DSN="https://your-dsn-key-here@o0.ingest.sentry.io/0"

# Mail Settings (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
# Preferred mail transport: Resend's HTTPS API. Railway blocks outbound SMTP ports
# (25/465/587), so the SMTP settings below time out there — set this instead.
RESEND_API_KEY=
SMTP_FROM=noreply@example.com

# Storage Settings (AWS S3 or compatible)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=recordings-bucket

# Firecrawl API
FIRECRAWL_API_KEY=fc-placeholder-key

# Gemini API (For Menu Extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Registration
# Set to true to allow public self-registration. Keep false (default) in production
# to require admin-provisioned accounts.
SELF_REGISTRATION_ENABLED=false

# First-admin provisioning (used by `npm run provision` — never set in the running app)
# Run: ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=SecurePass1! npm run provision
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!
# ADMIN_ROLE defaults to sysadmin. Use platform_admin for the root super-user.
ADMIN_ROLE=sysadmin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Billing cost rates (in cents)
COST_RATE_CALL_MINUTE_CENTS=5

# ── Order Aggregator (marketplace integrations: KitchenHub, DoorDash, ...) ──
# AES-256-GCM key for encrypting integration credentials at rest. MUST be exactly
# 32 characters. Generate: openssl rand -hex 16   (32 hex chars = 32 bytes)
AGGREGATOR_ENCRYPTION_KEY=change_me_to_32_char_secret_key!!
# KitchenHub API base URL (defaults to production if unset). KitchenHub relays
# DoorDash + Grubhub orders (attributed to those marketplaces at import).
KITCHENHUB_BASE_URL=https://api.kitchenhub.app/v2
# Uber Eats (direct integration). API + OAuth token endpoints (defaults are production).
# Credentials can arrive two ways:
#  - manually: stored (encrypted) on the integration_accounts row via
#    POST /api/v1/aggregator/integration-accounts with providerName=ubereats and
#    credentials={ clientId, clientSecret, storeId };
#  - self-serve: the merchant authorizes our app and the onboarding flow writes the same
#    row for them, using the app-level client id/secret below.
UBEREATS_BASE_URL=https://api.uber.com
UBEREATS_AUTH_URL=https://auth.uber.com/oauth/v2/token
# Our Uber app's own credentials (the same pair for every merchant). Required only for
# self-serve onboarding — the eats.pos_provisioning grant needs a merchant *user* token,
# which can only be minted through Uber's consent screen with these.
UBEREATS_CLIENT_ID=
UBEREATS_CLIENT_SECRET=
# Merchant consent screen. Defaults to UBEREATS_AUTH_URL with /token → /authorize, so
# pointing auth at the sandbox moves both halves of the flow together.
# UBEREATS_AUTHORIZE_URL=https://auth.uber.com/oauth/v2/authorize
# Must byte-match a redirect URI registered on the Uber app dashboard. Defaults to
# {PUBLIC_API_URL}/api/v1/aggregator/ubereats/onboarding/callback.
# UBEREATS_REDIRECT_URI=
# While developing against Uber's test-store program, point auth at their sandbox login
# instead (data still flows through the same UBEREATS_BASE_URL — Eats has no separate
# sandbox data host, only a separate token endpoint):
#   UBEREATS_AUTH_URL=https://sandbox-login.uber.com/oauth/v2/token
# OAuth scopes requested for the client-credentials token. Must match exactly what's
# granted on the Uber dashboard's Access Token page (per-app, not per Uber's generic docs —
# requesting an ungranted scope 400s the whole token request as invalid_scope). Default here
# mirrors this project's granted "POS Ordering" app scopes:
# UBEREATS_SCOPE=eats.order eats.store eats.report eats.store.orders.cancel eats.store.orders.read eats.store.orders.restaurantdelivery.status eats.store.status.write
# Register this as Uber's Primary Webhook URL (developer dashboard → Webhooks):
#   https://<your-host>/api/v1/webhooks/aggregator/ubereats
# Uber resolves the tenant from the store id in the body, so there is no per-store URL.
